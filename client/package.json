{
  "name": "client",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "portless run --name windower --force vite",
    "build": "vite build",
    "preview": "portless windower-preview vite preview",
    "preview:test": "vite preview --port 4173",
    "lint": "oxlint --fix && oxfmt && svelte-check --tsconfig ./tsconfig.app.json",
    "test": "vitest run",
    "test:e2e": "playwright test"
  },
  "dependencies": {
    "@tailwindcss/vite": "^4.3.3",
    "@tsconfig/node24": "^24.0.5",
    "ky": "^2.1.0",
    "mixpanel-browser": "^2.83.0",
    "tailwindcss": "^4.3.3"
  },
  "devDependencies": {
    "@playwright/test": "^1.63.0",
    "@sveltejs/vite-plugin-svelte": "^7.3.0",
    "@tsconfig/svelte": "^5.0.8",
    "@types/node": "^24.13.4",
    "oxfmt": "^0.36.0",
    "oxlint": "^1.82.0",
    "svelte": "^5.57.0",
    "svelte-check": "^4.7.6",
    "typescript": "~6.0.3",
    "vite": "^8.3.0",
    "vitest": "^5.0.0"
  }
}
